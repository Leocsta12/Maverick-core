# Copie este arquivo para .env.local e preencha com os valores do seu projeto
# Supabase (Settings > API no painel do projeto).
#
# EXPO_PUBLIC_* é o prefixo que o Expo expõe ao bundle do app — é assim que
# ele sabe que essas variáveis podem ir para o cliente. A anon key é uma
# chave pública por design (protegida pelas políticas de RLS no banco);
# nunca coloque a "service_role key" aqui.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Strava (módulo Health > Atividades) — Client ID de strava.com/settings/api.
# É seguro deixar público (é assim que toda integração OAuth funciona: só o
# Client Secret é sigiloso, e esse fica exclusivamente na Edge Function
# strava-oauth-callback via `supabase secrets set STRAVA_CLIENT_SECRET=...`).
EXPO_PUBLIC_STRAVA_CLIENT_ID=

# Monitoramento — opcional (ver src/lib/monitoring.ts). Sem essas duas, o
# app roda normal, só sem relatório de erro nem analytics de produto.
#
# Sentry (erro): crie um projeto React Native em sentry.io, copie o DSN em
# Settings > Client Keys (DSN). É uma chave pública por design (só recebe
# eventos, não dá acesso a nada).
EXPO_PUBLIC_SENTRY_DSN=
#
# PostHog (analytics de produto): crie um projeto em posthog.com (ou
# eu.posthog.com, se escolher a região EU), copie a "Project API Key" em
# Project Settings. Também pública por design (mesmo espírito da anon key
# do Supabase). EXPO_PUBLIC_POSTHOG_HOST só precisa mudar se seu projeto
# for na região EU (https://eu.i.posthog.com) — padrão é US.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
