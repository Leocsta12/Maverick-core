{
  "expo": {
    "name": "Maverick Performance",
    "slug": "maverick-core",
    "scheme": "maverick",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#0D0F11",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maverick.core"
    },
    "android": {
      "package": "com.maverick.core",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F11"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Maverick Core usa suas fotos pra anexar imagem de exercícios e registrar suas fotos de evolução no Maverick Vision."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0F11"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#FF5A1F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "leocstas-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b146d56-0577-4104-a9d1-64d956dfdbcb"
      }
    }
  }
}
